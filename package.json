{
  "name": "deepnest",
  "version": "1.2.1",
  "description": "Deep nesting for Laser and CNC",
  "main": "index.node.mjs",
  "license": "MIT",
  "bin": "cli.mjs",
  "scripts": {
    "start": "node server.mjs",
    "server": "node server.mjs",
    "test": "node --test tests/",
    "test:core": "node --test tests/core/",
    "test:server": "node --test tests/server/",
    "clean": "rmdir /s /q build dist >nul 2>&1|echo . >nul",
    "engine:build": "npm --prefix native/ironnest-napi install && npm --prefix native/ironnest-napi run build"
  },
  "repository": "https://github.com/deepnest-io/Deepnest",
  "keywords": [
    "Nesting",
    "CNC",
    "Laser"
  ],
  "author": {
    "name": "Jack Qiao",
    "email": "jak000@gmail.com"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "fs-extra": "^11.2.0",
    "jsdom": "^25.0.1",
    "ora": "^8.1.1"
  }
}
